---
// Dev-only playground: /toolkit/motion (injected by the toolkit integration in astro.config.mjs).
// Every preset from presets/reveal.css + reveal.ts, live, with the markup to copy.
import './tokens.css';
import './presets/reveal.css';
import './presets/compose.css';

const clients = ['Chelsea FC', 'FIBA', 'USGA', 'IndyCar', 'FINA', 'Emagine', 'SourceBible'];
const demos = [
  { id: 'lines', title: 'Поява тексту по рядках', from: 'Lama Lama, ERA', code: '<h2 data-reveal="lines">…</h2>' },
  { id: 'fade-up', title: 'Fade-up зі stagger', from: 'ERA, Shopify Editions', code: '<p data-reveal="fade-up">…</p>  ← сусіди отримують затримку автоматично' },
  { id: 'clip', title: 'Відкриття маскою', from: 'Son Daven, Lando Norris', code: '<figure data-reveal="clip" data-clip="up|left|center"><img …></figure>' },
  { id: 'blinds', title: 'Жалюзі', from: 'Son Daven', code: '<figure data-reveal="blinds" data-stripes="10"><img …></figure>' },
  { id: 'parallax', title: 'Шари з різною швидкістю', from: 'Son Daven, ERA, Lando Norris', code: '<img data-parallax="0.2">  ← від’ємне значення рухає у протилежний бік' },
  { id: 'draw', title: 'Малювання ліній', from: 'ERA, Shopify Editions', code: '<hr data-draw>  ·  <svg data-draw>…</svg>' },
  { id: 'scramble', title: 'Scramble', from: 'Lama Lama, Locomotive', code: '<span data-scramble data-duration="800">−32%</span>' },
  { id: 'marquee', title: 'Безкінечна стрічка', from: 'Son Daven, ERA', code: '<div data-marquee data-speed="60">…</div>' },
  { id: 'spring', title: 'Пружний hover', from: 'Shopify Editions, Obys', code: '<a class="tk-spring">…</a>' },
];
const demos2 = [
  { id: 'section-stack', title: 'Секції стосом', from: 'Floema, Shopify Editions', code: '<div class="tk-stack">\n  <section class="tk-stack__panel">…</section> ×N\n</div>' },
  { id: 'index-nav', title: 'Індекс-навігація', from: 'Shopify Editions, Obys, ERA', code: '<nav data-index="#scope" data-numbers="roman"></nav>\n<section data-index-title="Problem">…' },
  { id: 'projects-rows', title: 'Список робіт: рядки', from: 'Lama Lama', code: '<div class="tk-projects" data-variant="rows">\n  <a class="tk-project"> name · meta · .tk-project__strip </a>' },
  { id: 'projects-lens', title: 'Список робіт: лінза', from: 'Obys', code: '<div class="tk-projects" data-variant="lens">\n  .tk-lens__name · .tk-lens__col > .tk-project[data-name][data-meta] · .tk-lens__meta' },
  { id: 'entry', title: 'Вхід (раз за сесію)', from: 'Unseen, Floema, Lama Lama', code: '<body data-entry="Ivan Khoma" data-entry-duration="1800">' },
  { id: 'cursor', title: 'Курсор і лінза', from: 'Lando Norris, Obys', code: '<a data-cursor="View">…</a>\n<figure data-lens><img><img class="tk-lens__reveal"></figure>' },
];
const projects = [
  { name: 'Chelsea FC', meta: 'Mobile app · 2019—2024', tags: 'Sport · Media', hue: 220 },
  { name: 'FIBA', meta: 'Live scores · 2022', tags: 'Sport · Data', hue: 20 },
  { name: 'USGA', meta: 'Championship app · 2021', tags: 'Sport · Events', hue: 140 },
  { name: 'IndyCar', meta: 'Race hub · 2023', tags: 'Motorsport', hue: 0 },
  { name: 'FINA', meta: 'Aquatics app · 2020', tags: 'Sport · Media', hue: 190 },
  { name: 'SourceBible', meta: 'iOS app · 2026', tags: 'Founder · Study', hue: 40 },
];
// Lens demo: the same screen as a wireframe and as the final design.
const screen = (final: boolean) => {
  const bg = final ? '#e9e6dc' : '#1a1a19';
  const ink = final ? '#111' : 'none';
  const line = final ? 'none' : '#5c5c57';
  const box = (x: number, y: number, w: number, h: number, fill: string, r = 10) =>
    `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${r}" fill="${final ? fill : 'none'}" stroke="${line}" stroke-width="2" stroke-dasharray="${final ? '' : '8 6'}"/>`;
  const text = (x: number, y: number, w: number, h: number) =>
    final ? `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${h / 2}" fill="${ink}"/>` : `<line x1="${x}" y1="${y + h / 2}" x2="${x + w}" y2="${y + h / 2}" stroke="${line}" stroke-width="2"/>`;
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="1000"><rect width="1600" height="1000" fill="${bg}"/>
    ${text(80, 70, 220, 22)}${text(1200, 70, 320, 22)}
    ${final ? '<text x="80" y="330" font-family="Arial, sans-serif" font-weight="700" font-size="190" letter-spacing="-8" fill="#111">MATCH DAY</text>' : '<rect x="80" y="170" width="1100" height="180" fill="none" stroke="#5c5c57" stroke-width="2" stroke-dasharray="8 6"/><line x1="80" y1="170" x2="1180" y2="350" stroke="#5c5c57" stroke-width="2"/><line x1="1180" y1="170" x2="80" y2="350" stroke="#5c5c57" stroke-width="2"/>'}
    ${box(80, 430, 700, 470, '#0a3cc7', 24)}${box(820, 430, 340, 220, '#d2ff50', 24)}${box(1200, 430, 320, 220, '#111', 24)}
    ${box(820, 680, 700, 220, '#c9c4b5', 24)}
    ${text(130, 800, 360, 26)}${text(130, 850, 240, 18)}${text(860, 590, 200, 20)}${text(1240, 590, 200, 20)}
    ${final ? '<circle cx="560" cy="620" r="110" fill="#d2ff50"/><text x="560" y="642" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="64" fill="#0a3cc7">2–1</text>' : '<circle cx="560" cy="620" r="110" fill="none" stroke="#5c5c57" stroke-width="2" stroke-dasharray="8 6"/>'}
  </svg>`;
  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
};
const photo = (seed: number, w = 1200, h = 800) =>
  `data:image/svg+xml;utf8,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl(${seed} 30% 30%)"/><stop offset="1" stop-color="hsl(${seed + 40} 40% 14%)"/></linearGradient></defs><rect width="100%" height="100%" fill="url(#g)"/><circle cx="${w * 0.7}" cy="${h * 0.35}" r="${h * 0.22}" fill="hsl(${seed + 20} 60% 70% / .5)"/></svg>`)}`;
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Toolkit · Motion presets</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root { --bg: #101010; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: #ececec; font: 16px/1.5 Manrope, system-ui, sans-serif; }
    .wrap { max-width: 1600px; margin: 0 auto; padding: 0 80px; }
    header { padding: 120px 0 80px; }
    header h1 { font-size: clamp(56px, 8vw, 128px); line-height: .9; letter-spacing: -.04em; margin: 0 0 24px; font-weight: 500; }
    header p { color: #8f8e88; max-width: 60ch; margin: 0; }
    nav.toc { position: sticky; top: 0; z-index: 5; background: rgba(16,16,16,.85); backdrop-filter: blur(8px); border-block: 1px solid #262624; }
    nav.toc .wrap { display: flex; gap: 20px; flex-wrap: wrap; padding-block: 12px; font-size: 13px; }
    nav.toc a { color: #8f8e88; text-decoration: none; } nav.toc a:hover { color: #d2ff50; }
    section.demo { padding: 120px 0; border-bottom: 1px solid #262624; }
    .head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 20px; margin-bottom: 48px; align-items: end; }
    .head .n { grid-column: span 2; color: #8f8e88; font-size: 13px; }
    .head h2 { grid-column: span 6; margin: 0; font-size: 40px; letter-spacing: -.02em; font-weight: 500; }
    .head .meta { grid-column: span 4; font-size: 13px; color: #8f8e88; }
    code { display: block; margin-top: 8px; font: 12px ui-monospace, Menlo, monospace; color: #d2ff50; white-space: pre-wrap; }
    .g { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 20px; }
    .big { font-size: clamp(40px, 5vw, 80px); line-height: 1; letter-spacing: -.03em; margin: 0; font-weight: 500; }
    .lead { font-size: 28px; line-height: 1.3; letter-spacing: -.01em; margin: 0; }
    figure { margin: 0; border-radius: 24px; overflow: hidden; }
    figure img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .card { background: #1a1a19; border-radius: 20px; padding: 28px; min-height: 180px; }
    .card b { display: block; font-size: 48px; letter-spacing: -.03em; color: #d2ff50; }
    .tall { height: 70vh; position: relative; overflow: hidden; border-radius: 24px; background: #151514; }
    .tall .layer { position: absolute; border-radius: 16px; overflow: hidden; }
    .marquee-item { font-size: 72px; letter-spacing: -.03em; padding-right: 64px; white-space: nowrap; color: #e8e8e8; }
    .marquee-item::after { content: '✳'; color: #d2ff50; margin-left: 64px; }
    .btn { display: inline-flex; padding: 18px 32px; border-radius: 99px; background: #d2ff50; color: #111; font-weight: 700; text-decoration: none; margin-right: 12px; }
    .chip { display: inline-flex; padding: 10px 18px; border-radius: 99px; border: 1px solid #3a3a37; color: #ececec; text-decoration: none; }
    .stack-panel { display: flex; flex-direction: column; justify-content: space-between; padding: 48px; border-radius: 24px; }
    .stack-panel .n { color: #8f8e88; font-size: 13px; }
    .index-sec { min-height: 60vh; border-top: 1px solid #262624; padding-top: 24px; }
    @media (max-width: 810px) { .wrap { padding: 0 16px; } .head > * { grid-column: 1 / -1 !important; } .g > * { grid-column: 1 / -1 !important; } }
  </style>
</head>
<body>
  <header class="wrap">
    <h1 data-reveal="lines">Motion presets</h1>
    <p data-reveal="fade-up">Пресети з motion-зрізу 2026, які ти обрав. Скроль униз: кожен блок показує пресет наживо, а праворуч — розмітку для підключення. Перевір і з «Reduce motion» у системних налаштуваннях: усе має стояти на місці.</p>
  </header>
  <nav class="toc"><div class="wrap">{demos.map((d) => <a href={`#${d.id}`}>{d.title}</a>)}</div></nav>

  {demos.map((d, i) => (
    <section class="demo" id={d.id}>
      <div class="wrap">
        <div class="head">
          <span class="n">{String(i + 1).padStart(2, '0')} · {d.id}</span>
          <h2>{d.title}</h2>
          <div class="meta">Референс: {d.from}<code>{d.code}</code></div>
        </div>

        {d.id === 'lines' && (
          <div class="g">
            <h3 class="big" style="grid-column: 1 / span 9" data-reveal="lines">Redesigning how millions of fans follow the club on match day</h3>
            <p class="lead" style="grid-column: 3 / span 8; margin-top: 40px" data-reveal="lines">Chelsea FC’s official app needed to feel as fast as the game. We rebuilt live match centre, news and video around a single, glanceable feed.</p>
          </div>
        )}
        {d.id === 'fade-up' && (
          <div class="g">
            {['−32% churn', '+18% DAU', '4.8 ★ App Store', '2M+ fans'].map((t) => (
              <div class="card" style="grid-column: span 3" data-reveal="fade-up"><b>{t.split(' ')[0]}</b>{t.split(' ').slice(1).join(' ')}</div>
            ))}
          </div>
        )}
        {d.id === 'clip' && (
          <div class="g">
            <figure style="grid-column: span 6; aspect-ratio: 4/3" data-reveal="clip"><img src={photo(200)} alt="" /></figure>
            <figure style="grid-column: span 3; aspect-ratio: 3/4" data-reveal="clip" data-clip="left"><img src={photo(20)} alt="" /></figure>
            <figure style="grid-column: span 3; aspect-ratio: 3/4" data-reveal="clip" data-clip="center"><img src={photo(320)} alt="" /></figure>
          </div>
        )}
        {d.id === 'blinds' && (
          <figure style="aspect-ratio: 21/9" data-reveal="blinds" data-stripes="12"><img src={photo(30, 2100, 900)} alt="" /></figure>
        )}
        {d.id === 'parallax' && (
          <div class="tall">
            <div class="layer" style="left: 6%; top: 18%; width: 26%; height: 52%" data-parallax="0.35"><img src={photo(210, 600, 900)} alt="" style="width:100%;height:100%;object-fit:cover" /></div>
            <div class="layer" style="left: 38%; top: 8%; width: 24%; height: 40%" data-parallax="-0.2"><img src={photo(10, 600, 900)} alt="" style="width:100%;height:100%;object-fit:cover" /></div>
            <div class="layer" style="left: 66%; top: 30%; width: 28%; height: 56%" data-parallax="0.15"><img src={photo(300, 600, 900)} alt="" style="width:100%;height:100%;object-fit:cover" /></div>
          </div>
        )}
        {d.id === 'draw' && (
          <div class="g">
            <div style="grid-column: span 12"><hr data-draw style="border:0;border-top:1px solid #3a3a37;margin:0 0 48px" /></div>
            <svg data-draw viewBox="0 0 600 160" style="grid-column: span 8; width: 100%; height: auto" fill="none" stroke="#d2ff50" stroke-width="1.5">
              <rect x="10" y="40" width="120" height="80" rx="12" />
              <path d="M130 80 H230" />
              <rect x="230" y="40" width="120" height="80" rx="12" />
              <path d="M350 80 H450" />
              <circle cx="510" cy="80" r="50" />
            </svg>
            <p style="grid-column: span 4; color:#8f8e88">Роздільники секцій і схеми user flow в кейсах. SVG-фігури малюються по черзі.</p>
          </div>
        )}
        {d.id === 'scramble' && (
          <div class="g">
            {['MATCH DAY', '−32%', 'iOS · ANDROID', '2019—2024'].map((t) => (
              <div class="card" style="grid-column: span 3"><b data-scramble data-duration="900" style="font-family: ui-monospace, Menlo, monospace; font-size: 32px">{t}</b></div>
            ))}
          </div>
        )}
        {d.id === 'marquee' && (
          <div data-marquee data-speed="70">{clients.map((c) => <span class="marquee-item">{c}</span>)}</div>
        )}
        {d.id === 'spring' && (
          <div><a href="#spring" class="btn tk-spring">Let’s talk</a><a href="#spring" class="chip tk-spring">Product design</a></div>
        )}
      </div>
    </section>
  ))}

  <header class="wrap" style="padding-top: 160px">
    <h1 data-reveal="lines">Batch two: composition</h1>
    <p data-reveal="fade-up">Пресети, що будують сторінку цілком: стос секцій, індекс, браузер робіт, вхід і курсор. Підключення: compose.css + <code style="display:inline">initCompose()</code> з presets/compose.ts.</p>
  </header>
  <nav class="toc"><div class="wrap">{demos2.map((d) => <a href={`#${d.id}`}>{d.title}</a>)}</div></nav>

  {demos2.map((d, i) => (
    <section class="demo" id={d.id}>
      <div class="wrap">
        <div class="head">
          <span class="n">{String(demos.length + i + 1).padStart(2, '0')} · {d.id}</span>
          <h2>{d.title}</h2>
          <div class="meta">Референс: {d.from}<code>{d.code}</code></div>
        </div>

        {d.id === 'section-stack' && (
          <div class="tk-stack">
            {['Problem', 'Process', 'Solution', 'Impact'].map((t, j) => (
              <section class="tk-stack__panel stack-panel" style={`background: hsl(${80 + j * 60} 12% ${14 + j * 3}%)`}>
                <span class="n">{String(j + 1).padStart(2, '0')}</span>
                <h3 class="big">{t}</h3>
              </section>
            ))}
          </div>
        )}
        {d.id === 'index-nav' && (
          <div class="g" id="index-scope">
            <nav style="grid-column: span 3" data-index="#index-scope" data-numbers="roman" aria-label="Зміст кейсу"></nav>
            <div style="grid-column: 5 / span 8">
              {['Overview', 'Problem', 'Research', 'Design system', 'Match centre', 'Impact'].map((t) => (
                <section data-index-title={t} class="index-sec">
                  <h3 class="lead" style="margin-bottom: 16px">{t}</h3>
                  <p style="color:#8f8e88; max-width: 56ch">Блок кейсу. Індекс зліва підсвічує поточну секцію, лінія внизу показує прогрес читання; клік скролить до секції.</p>
                </section>
              ))}
            </div>
          </div>
        )}
        {d.id === 'projects-rows' && (
          <div class="tk-projects" data-variant="rows">
            {projects.map((p) => (
              <a class="tk-project" href="#projects-rows" data-cursor="Open">
                <span class="tk-project__name">{p.name}</span>
                <span class="tk-project__meta">{p.meta}</span>
                <span class="tk-project__strip">{[0, 1, 2].map((k) => <img src={photo(p.hue + k * 25, 300, 400)} alt="" />)}</span>
              </a>
            ))}
          </div>
        )}
        {d.id === 'projects-lens' && (
          <div class="tk-projects" data-variant="lens">
            <div class="tk-lens__name" aria-live="polite"></div>
            <div class="tk-lens__col" tabindex="0" aria-label="Проєкти: гортай колесом або стрілками">
              {projects.map((p) => (
                <a class="tk-project" href="#projects-lens" data-name={p.name} data-meta={p.meta} data-tags={p.tags} data-cursor="View"><img src={photo(p.hue, 720, 900)} alt={p.name} /></a>
              ))}
            </div>
            <div class="tk-lens__meta"></div>
          </div>
        )}
        {d.id === 'entry' && (
          <div class="g">
            <p class="lead" style="grid-column: span 7">На сайті вмикається атрибутом <code style="display:inline">data-entry</code> на body: показується раз за сесію, ≤2 с, Esc або клік пропускає, з «Reduce motion» не показується зовсім.</p>
            <div style="grid-column: 9 / span 4"><button class="btn" id="replay-entry" type="button" style="border:0; cursor:pointer; font: inherit; font-weight: 700">Програти вхід</button></div>
          </div>
        )}
        {d.id === 'cursor' && (
          <div class="g">
            <figure style="grid-column: span 7; aspect-ratio: 16/10" data-lens><img src={screen(false)} alt="Wireframe екрану" /><img class="tk-lens__reveal" src={screen(true)} alt="Фінальний дизайн екрану" /></figure>
            <div style="grid-column: 9 / span 4; display: flex; flex-direction: column; gap: 16px; align-items: flex-start">
              <p style="color:#8f8e88; margin:0">Наведи на екран: лінза показує фінальний дизайн поверх wireframe. Так само працює до/після. Кнопки й картки з <code style="display:inline">data-cursor</code> показують підпис. На тач-екранах вимкнено.</p>
              <a class="btn" href="#cursor" data-cursor="Write">Let’s talk</a>
              <a class="chip" href="#cursor" data-cursor="Case">Chelsea FC</a>
            </div>
          </div>
        )}
      </div>
    </section>
  ))}
  <div style="height: 50vh"></div>

  <script>
    import { initMotion } from './presets/reveal';
    import { initCompose, showEntry } from './presets/compose';
    document.fonts.ready.then(() => { initMotion(); initCompose(); });
    document.getElementById('replay-entry')?.addEventListener('click', () => showEntry({ text: 'Ivan Khoma', force: true }));
  </script>
</body>
</html>

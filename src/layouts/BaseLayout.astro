---
import '../index.css';
interface Props { title?: string; description?: string; }
const { title = 'Ivan Khoma — Product Designer', description = 'Selected product design and engineering work by Ivan Khoma.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <script>
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
        const back = event.target.closest('[data-case-back]');
        if (!back || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (document.referrer && new URL(document.referrer).origin === location.origin && history.length > 1) {
          event.preventDefault();
          history.back();
        }
      });
    </script>
  </body>
</html>
